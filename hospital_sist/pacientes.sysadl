} port def MonitorSinaisVitaisCentralOut { flow out RegistroMedicaoVT port def MonitorSinaisVitaisLocalOut { flow out RegistroMedicaoVT } } port def SistemaCentralHistoricoIn { flow in RegistroMedicaoVT port def MonitorSinaisVitaisLocalOut { flow out RegistroMedicaoVT } } port def SistemaCentralHistoricoOut { flow out RegistroMedicaoVT port def MonitorSinaisVitaisLocalOut { flow out RegistroMedicaoVT } } port def SistemaCentralVisualizacaoIn { flow in RegistroMedicaoVT port def MonitorSinaisVitaisLocalOut { flow out RegistroMedicaoVT } } port def SistemaCentralVisualizacaoOut { flow out RegistroMedicaoVT port def MonitorSinaisVitaisLocalOut { flow out RegistroMedicaoVT } } port def RepositorioHistoricoIn { flow in RegistroMedicaoVT } port def RepositorioHistoricoOut { flow out RegistroMedicaoVT } port def VisualizacaoCentralIn { flow in RegistroMedicaoVT } port def VisualizacaoCentralOut { flow out RegistroMedicaoVT } port def GerenciadorLeitosDisponibilidadeIn { flow in DadosLeitoVT } port def GerenciadorLeitosDisponibilidadeOut { flow out DadosLeitoVT } port def GerenciadorLeitosConsultaPacienteIn { flow in IdentificadorPacienteVT } port def GerenciadorLeitosConsultaPacienteOut { flow out IdentificadorPacienteVT } } Requirement SistPacientesRequisitos ( 0 ) { text = "O sistema deve satisfazer as necessidades representadas por requisitos funcionais e não funcionais." satisfied by SysADL.types.SysALDCP ; Requirement MonitorarSSVVFR ( 1 ) { text = "O sistema deve ser capaz de inferir os sinais vitais de um paciente de acordo com as necessidades médicas." satisfied by SysADL.types.MonitorSinaisVitaisCP ; Requirement MonitorarFCFR ( 1.1 ) { text = "O sistema deve ser capaz de inferir a frequência cardíaca de um paciente por meio de um sensor." satisfied by SysADL.types.SensorFrequenciaCardiacaCP ; } Requirement MonitorarPAFR ( 1.2 ) { text = "O sistema deve ser capaz de inferir a pressão arterial de um paciente por meio de um sensor." satisfied by SysADL.types.SensorPressaoArterialCP ; } Requirement MonitorarFRFR ( 1.3 ) { text = "O sistema deve ser capaz de inferir a frequência respiratória de um paciente por meio de um sensor." satisfied by SysADL.types.SensorFrequenciaRespiratoriaCP ; } Requirement MonitorarTFR ( 1.4 ) { text = "O sistema deve ser capaz de inferir a temperatura de um paciente por meio de um sensor." satisfied by SysADL.types.SensorTemperaturaCP ; } Requirement MonitorarSpO2FR ( 1.5 ) { text = "O sistema deve ser capaz de inferir a saturação periférica de oxigênio do paciente por meio de um sensor." satisfied by SysADL.types.SensorOximetriaCP ; } } Requirement VisualizarSSVVFR ( 2 ) { text = "O sistema deve fornecer uma interface de acesso aos dados do(s) paciente(s), tal como seus sinais vitais." satisfied by SysADL.types.VisualizacaoPacientesCP ; Requirement VisualizarRemotamenteFR ( 2.2 ) { text = "Deve existir uma interface centralizada de visualização dos dados dos pacientes, acessível por dispositivos de borda." satisfied by SysADL.types.VisualizacaoCentralCP ; Requirement SistCentralFR ( 2.2.1 ) { text = "Há de existir uma unidade central física para onde os dados do sistema são repassados e então tratados." satisfied by SysADL.types.SistemaCentralCP ; Requirement ArmazenamentoDadosFR ( 2.2.1.1 ) { text = "Um histórico dos dados vitais dos pacientes deve ser armazenado." satisfied by SysADL.types.RepositorioHistoricoCP ; } Requirement VisualizarBordaFR ( 2.2.1.2 ) { text = "Deve existir uma forma dos profissionais (e do próprio paciente) acessarem o sistema central utilizando dispositivos de borda." satisfied by SysADL.types.InterfaceBordaCP ; } Requirement GerenciarLeitosFR ( 2.2.1.3 ) { text = "O sistema central deve administrar o estado atual de cada leito (quanto à sua disponibilidade e quanto ao perfil do paciente internado)." satisfied by SysADL.types.GerenciadorLeitosCP ; derive VisualizarLocalLeitoFR ; } Requirement ConexaoSistPacientesFR ( 2.2.1.4 ) { text = "O sistema deve ter acesso aos dados de gerenciamento de pacientes do hospital." satisfied by SysADL.types.IntegracaoHospitalarCP ; } } } Requirement VisualizarLocalmenteFR ( 2.1 ) { text = "Deve ser fornecida uma interface local e direta de visualização dos dados, sem dependência do sistema central." satisfied by SysADL.types.InterfaceLocalCP ; } } } Requirement VisualizarLocalLeitoFR ( 2.1.1 ) { text = "Deve existir a possibilidade de visualizar binariamente a disponibilidade de um leito." satisfied by SysADL.types.IndicadorDisponibilidadeLeitoCP ; }