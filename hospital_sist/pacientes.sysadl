Model SysADLModel ; package SysADL.types { value type Int { } value type Boolean { } value type String { } value type Void { } value type Real { } } Requirement SistPacientesRequisitos ( 0 ) { text = "O sistema deve satisfazer as necessidades representadas por requisitos funcionais e não funcionais." Requirement MonitorarSSVVFR ( 1 ) { text = "O sistema deve ser capaz de inferir os sinais vitais de um paciente de acordo com as necessidades médicas." Requirement MonitorarFCFR ( 1.1 ) { text = "O sistema deve ser capaz de inferir a frequência cardíaca de um paciente por meio de um sensor." } Requirement MonitorarPAFR ( 1.2 ) { text = "O sistema deve ser capaz de inferir a pressão arterial de um paciente por meio de um sensor." } Requirement MonitorarFRFR ( 1.3 ) { text = "O sistema deve ser capaz de inferir a frequência respiratória de um paciente por meio de um sensor." } Requirement MonitorarTFR ( 1.4 ) { text = "O sistema deve ser capaz de inferir a temperatura de um paciente por meio de um sensor." } Requirement MonitorarSpO2FR ( 1.5 ) { text = "O sistema deve ser capaz de inferir a saturação periférica de oxigênio do paciente por meio de um sensor." } } Requirement VisualizarSSVVFR ( 2 ) { text = "O sistema deve fornecer uma interface de acesso aos dados do(s) paciente(s), tal como seus sinais vitais." Requirement VisualizarRemotamenteFR ( 2.2 ) { text = "Deve existir uma interface centralizada de visualização dos dados dos pacientes, acessível por dispositivos de borda." Requirement SistCentralFR ( 2.2.1 ) { text = "Há de existir uma unidade central física para onde os dados do sistema são repassados e então tratados." Requirement ArmazenamentoDadosFR ( 2.2.1.1 ) { text = "Um histórico dos dados vitais dos pacientes deve ser armazenado." } Requirement VisualizarBordaFR ( 2.2.1.2 ) { text = "Deve existir uma forma dos profissionais (e do próprio paciente) acessarem o sistema central utilizando dispositivos de borda." } Requirement GerenciarLeitosFR ( 2.2.1.3 ) { text = "O sistema central deve administrar o estado atual de cada leito (quanto à sua disponibilidade e quanto ao perfil do paciente internado)." derive VisualizarLocalLeitoFR ; } Requirement ConexaoSistPacientesFR ( 2.2.1.4 ) { text = "O sistema deve ter acesso aos dados de gerenciamento de pacientes do hospital." } } } Requirement VisualizarLocalmenteFR ( 2.1 ) { text = "Deve ser fornecida uma interface local e direta de visualização dos dados, sem dependência do sistema central." } } } Requirement VisualizarLocalLeitoFR ( 2.1.1 ) { text = "Deve existir a possibilidade de visualizar binariamente a disponibilidade de um leito." }