	component def dispSonoro { } }  Requirement gerenciadorDeTarefas ( 3 ) { text = "O sistema deve reunir todos os dados aqui para processar e soltar alertas com base nos resultados" satisfied by SysADL.types.servidorGeral ; Requirement MonitoramentoDeSinaisVitais ( 1) { satisfied by SysADL.types.monitorMultiparametrico ; Requirement freqRespiratoria ( 1.2 ) { text = "O sistema deve receber a frequência respiratória do paciente." satisfied by SysADL.types.monitorFreqResp ; } Requirement pressaoArterial ( 1.3 ) { text = "O sistema deve receber a pressão arterial do paciente." satisfied by SysADL.types.monitorPessaoArterial ; } Requirement freqCardiaca ( 1.1 ) { text = "O sistema deve receber a frequência cardíaca do paciente." satisfied by SysADL.types.monitorFreqCardiaca ; } Requirement dataHoraMedicao ( 1.4 ) { text = "O sistema deve registrar a data e hora de cada medição." satisfied by SysADL.types.relogio ; } }  Requirement gerenciamentoDePacientes ( 2 ) { text = "O sistema deve permitir cadastrar, consultar,excluir e atualizar pacientes." satisfied by SysADL.types.webService ; } Requirement AlertaMalfuncionamento ( 4 ) { text = "Avisa se algum equipamento para de mandar sinais" satisfied by SysADL.types.dispSonoro ; } Requirement AlertaSInaisCriticos ( 5 ) { text = "Avisa se o paciente tem sinais vitais preocupantes" satisfied by SysADL.types.dispSonoro ; } }